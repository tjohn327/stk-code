<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="0%" y="0%" width="100%" height="100%" layout="vertical-row">
        
        <!-- Header spacer -->
        <spacer proportion="2" width="10" />
        
        <!-- Main content area -->
        <div width="100%" height="fit" layout="vertical-row" align="center">
            
            <!-- Title -->
            <label id="title" I18N="In network name screen" text="Enter your name for this race session:" 
                   width="80%" height="fit" text_align="center" font="large"/>
            
            <!-- Spacer -->
            <spacer height="8%" width="10" />
            
            <!-- Text input field -->
            <div width="60%" height="fit" layout="horizontal-row" align="center">
                <textbox id="textfield" proportion="1" height="fit" max_chars="30" 
                         I18N="In network name screen" text=""/>
            </div>
            
            <!-- Spacer -->
            <spacer height="4%" width="10" />
            
            <!-- Subtitle -->
            <label id="subtitle" I18N="In network name screen" 
                   text="(This name will be used only for this session)" 
                   width="80%" height="fit" text_align="center" font="normal"/>
            
            <!-- Spacer -->
            <spacer height="10%" width="10" />
            
            <!-- Buttons -->
            <div width="50%" height="fit" layout="horizontal-row" align="center">
                
                <icon-button id="cancel" width="fit" height="fit" icon="gui/icons/red_x.png"
                    I18N="In network name screen" text="Cancel" align="center"/>
                
                <spacer width="10%" height="10" />
                
                <icon-button id="ok" width="fit" height="fit" icon="gui/icons/green_check.png"
                    I18N="In network name screen" text="OK" align="center"/>
                    
            </div>
            
        </div>
        
        <!-- Footer spacer -->
        <spacer proportion="3" width="10" />
        
    </div>
</stkgui>