<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="2%" y="10%" width="96%" height="80%" layout="vertical-row" >
        <label id="title" I18N="In network name dialog" text="Enter your name for this race session:" width="100%" height="30%"/>

        <spacer height="5%" width="10" />
        <textbox id="textfield" width="75%" align="center" max_chars="30"/>
        <spacer height="2%" width="10" />
        <label id="subtitle" I18N="In network name dialog" text="(This name will be used only for this session)" width="100%" height="15%" text_align="center"/>
        <spacer proportion="1" width="10" />

        <buttonbar id="buttons" height="30%" width="30%" align="center">

            <icon-button id="cancel" width="128" height="128" icon="gui/icons/red_x.png"
                I18N="In network name dialog" text="Cancel" align="center"/>

            <icon-button id="ok" width="128" height="128" icon="gui/icons/green_check.png"
                I18N="In network name dialog" text="OK" align="center"/>

        </buttonbar>
    </div>
</stkgui>